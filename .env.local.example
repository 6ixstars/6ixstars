# =====================================================
# 6ixstars — Variables de entorno
# Copia este archivo a .env.local y completa los valores.
# =====================================================

# -----------------------------------------------------
# SUPABASE — Catálogo y órdenes (proyecto NUEVO de 6ixstars)
# -----------------------------------------------------
# Obtén estos valores en: Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key_aqui
# Service role: SOLO server-side. NUNCA commitear ni exponer al frontend.
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui

# -----------------------------------------------------
# BOLD — Pasarela de pago (Colombia)
# -----------------------------------------------------
# Dashboard Bold → Integraciones → Llaves de integración → Pagos en línea / Link de pagos.
# La llave de identidad es pública (se puede exponer); la llave secreta es SOLO server-side
# y solo se usa para validar la firma de los webhooks.
NEXT_PUBLIC_BOLD_PUBLIC_KEY=tu_llave_de_identidad_aqui
BOLD_SECRET_KEY=tu_llave_secreta_aqui

# -----------------------------------------------------
# SITIO
# -----------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Tasa USD → COP (si tus precios ya están en COP, pon 1)
NEXT_PUBLIC_USD_TO_COP_RATE=1

# =====================================================
# Tarjetas de prueba (sandbox): ver developers.bold.co — no confirmadas aquí,
# no asumir que las de Wompi (4242.../4111...) sirven para Bold.
# Webhook (post-deploy): configurarlo en el dashboard de Bold → Webhooks,
# apuntando a https://tu-dominio.com/api/bold/webhook
# =====================================================
